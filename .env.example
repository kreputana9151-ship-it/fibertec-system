# Address people type in the browser: https://fibertecitsolutions.test (no :3000). See README > "Custom address".
APP_HOST=fibertecitsolutions.test
PORT=443
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/fibertec
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=8h
SEED_PASSWORD=ChangeMe123!

# HTTPS (run "npm run cert" once). Remove both lines to run on plain http.
SSL_KEY_PATH=certs/localhost-key.pem
SSL_CERT_PATH=certs/localhost.pem
# Only when deployed behind a host that already provides https (Render, Railway, ...)
# TRUST_PROXY=true
# FORCE_HTTPS=true
# Only if the frontend is served from a different origin
# CORS_ORIGIN=http://localhost:5500

# PayMongo is OFF until your group has a subscription / test keys
PAYMONGO_ENABLED=false
PAYMONGO_SECRET_KEY=

# Email through Brevo (Render > Environment). Needs a VERIFIED sender in Brevo > Senders, Domains & Dedicated IPs.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=FiberTec IT Solutions
# Your public address, used for links inside emails, e.g. https://your-app.onrender.com
# APP_URL=https://your-app.onrender.com
